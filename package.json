{
  "name": "morphis",
  "private": true,
  "version": "0.1.0",
  "description": "MORPHIS — a living 3D cyberpunk city and AI workforce simulation",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @morphis/web",
    "dev:server": "npm run dev --workspace @morphis/server",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "npm run build --workspace @morphis/web",
    "build:static": "npm run build:static --workspace @morphis/web",
    "start:server": "npm run start --workspace @morphis/server",
    "typecheck": "tsc -p packages/shared && tsc -p packages/sim && tsc -p apps/server && tsc -p apps/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:generate": "npm run db:generate --workspace @morphis/server",
    "db:push": "npm run db:push --workspace @morphis/server"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "^4.1.12",
    "@playwright/test": "1.63.0",
    "eslint": "^9.36.0",
    "@eslint/js": "^9.36.0",
    "typescript-eslint": "^8.44.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "vite": "^7.3.7"
  }
}
