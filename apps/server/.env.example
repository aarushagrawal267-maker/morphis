# --- Server
PORT=8787
HOST=0.0.0.0
# Allowed browser origins (comma separated). Use * for development only.
CORS_ORIGIN=*

# --- Persistence: PostgreSQL via Prisma. Leave empty to use JSON files in ./data/saves
DATABASE_URL=postgresql://postgres:morphis@127.0.0.1:5432/morphis

# --- Simulation
CITY_SEED=2126
CITY_POPULATION=400
AUTOSAVE_MINUTES=0

# --- AI provider (optional). Without it the workforce is simulated and clearly labelled.
# OpenAI-compatible endpoints: NVIDIA NIM, OpenAI, OpenRouter, Ollama, vLLM...
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b
AI_API_KEY=
# Anthropic instead: AI_PROVIDER=anthropic, AI_API_KEY=..., AI_MODEL=claude-sonnet-5-5
AI_REQUESTS_PER_MINUTE=30
AI_MAX_TOKENS=1800
AI_DAILY_REQUEST_CAP=400
